def sz(b):
    for u in ("B","KB","MB","GB","TB","PB","ZB","YB"):
        if b<1024: return f"{int(b)} B" if u=="B" else f"{b:.2f} {u}"
        b/=1024
    return f"{b:.2f} YB"

class Srv(BaseHTTPRequestHandler):
    def log_message(self, *a): pass
    def do_GET(self):
        p = urllib.parse.urlparse(self.path)
        if p.path == "/translate":
            qs = urllib.parse.parse_qs(p.query)
            q = urllib.parse.quote(qs.get("q", [""])[0])
            sl, tl = qs.get("sl", ["auto"])[0], qs.get("tl", ["en"])[0]
            try:
                u = f"https://googleapis.com{sl}&tl={tl}&dt=t&q={q}"
                d = json.loads(urllib.request.urlopen(u, timeout=8).read())
                res = "".join(x[0] for x in d[0] if x and x[0])
            except Exception:
                res = qs.get("q", [""])[0]
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            self.wfile.write(json.dumps({"text": res}).encode())
        else:
            fn = "/err.html" if p.path == "/err" else "/home.html"
            self.send_response(200)
            self.send_header("Content-Type", "text/html;charset=utf-8")
            self.end_headers()
            self.wfile.write(open(B + fn, "rb").read())

srv=ThreadingHTTPServer(("127.0.0.1",0),Srv)
