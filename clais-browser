class Shield(QWebEngineUrlRequestInterceptor):
    def interceptRequest(self,i):
        u=i.requestUrl()
        if any(x in u.host() for x in ("doubleclick.net","google-analytics.com","facebook.net")):i.block(True)
        elif u.scheme()=="http" and u.host() not in ("localhost","127.0.0.1"):u.setScheme("https");i.redirect(u)

