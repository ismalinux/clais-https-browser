    def __init__(self,w): super().__init__();self.w=w
    def createWindow(self,_): return self.w.tab(QUrl("about:blank"))

class Browser(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Clais HTTPS Browser");self.setWindowIcon(QIcon(ICON))
        self.resize(1280,820);self.th,self.dls=0,[];self.setStyleSheet(CSS.pop(0))
        p=QWebEngineProfile.defaultProfile();st=os.path.expanduser("~/.local/share/ClaisBrowser")
        os.makedirs(st,exist_ok=True);os.makedirs(DL,exist_ok=True)
        p.setPersistentStoragePath(st);p.setDownloadPath(DL);p.downloadRequested.connect(self.dl)
        #
        p.setHttpUserAgent("Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0.0.0 Safari/537.36")
        p.settings().setAttribute(QWebEngineSettings.WebAttribute.JavascriptEnabled,True)
        p.settings().setAttribute(QWebEngineSettings.WebAttribute.LocalStorageEnabled,True)
        self.tabs=QTabWidget(documentMode=True);self.setCentralWidget(self.tabs)
        nav=QToolBar(movable=False);self.addToolBar(nav)
        for t,fn in [("←",lambda:self.cur().back()),("→",lambda:self.cur().forward()),
            ("↻",lambda:self.cur().reload()),("⌂",lambda:self.cur().setUrl(HOME)),
            ("+",lambda:self.tab(HOME)),("☀/🌑",self.flip),("★ Upgrade",lambda:self.tab(STRIPE))]:
            a=QAction(t,self);a.triggered.connect(fn);nav.addAction(a)
        self.bar=QLineEdit(placeholderText="Enter HTTPS URL...");self.bar.returnPressed.connect(self.go)
        nav.addWidget(self.bar);self.db=QPushButton("↓");self.db.clicked.connect(self.menu)
        nav.addWidget(self.db);self.tab(HOME)

    def go(self):
        t=self.bar.text().strip()
        if t:
            if "." not in t and "://" not in t: self.cur().setUrl(QUrl(f"http://127.0.0.1:{PORT}/err")); self.bar.setText(""); return
            self.cur().setUrl(QUrl(t if "://" in t else "https://"+t))

    def ok_sp(self,n):
        d,r=shutil.disk_usage(DL).free,os.sysconf("SC_PAGE_SIZE")*os.sysconf("SC_AVPHYS_PAGES")
        if n>0 and (n>r+d if n>=1024**4 else n>d):
            try:self.db.setText("✕ No Space");self.db.setStyleSheet("background:#dc2626")
            except RuntimeError:pass
            QMessageBox.warning(self,"Error","Could not download the file: you don't have more space.")
            return False
        return True

    def dl(self,it):
        if not self.ok_sp(it.totalBytes()):return it.cancel()
        it.setDownloadDirectory(DL);fn,fp,t0=it.downloadFileName(),os.path.join(DL,it.downloadFileName()),time.time()
        it.accept()
        def tick():
            r,t=it.receivedBytes(),it.totalBytes()
            if not self.ok_sp(max(t-r,0)):return it.cancel()
            m,s=divmod(int((t-r)/max(r/max(time.time()-t0,0.1),1)),60) if t>0 else (0,0)
            try:self.db.setText(f"↓ {int(r*100/t)}% ({sz(t)}) • {m:02d}:{s:02d}" if t>0 else f"↓ {sz(r)}");self.db.setStyleSheet("background:#ff5500")
            except RuntimeError:pass
        def done(st):
            if st==it.DownloadState.DownloadCompleted:
                s=sz(it.totalBytes() or it.receivedBytes());self.dls.insert(0,(fn,fp,s))
                try:self.db.setText(f"↓ ✓ ({s})");self.db.setStyleSheet("background:#16a34a")
                except RuntimeError:pass
        it.receivedBytesChanged.connect(tick);it.stateChanged.connect(done)

    def menu(self):
        m=QMenu(self)
        for fn,fp,s in self.dls[:10]:m.addAction(f"✓ {fn} ({s})").triggered.connect(lambda _,p=fp:QDesktopServices.openUrl(QUrl.fromLocalFile(p)))
        m.addAction("📂 Open Downloads").triggered.connect(lambda:QDesktopServices.openUrl(QUrl.fromLocalFile(DL)))
        m.exec(self.db.mapToGlobal(self.db.rect().bottomLeft()))

    def flip(self):self.th^=1;self.setStyleSheet(CSS[self.th])
    def cur(self):return self.tabs.currentWidget()

    def tab(self,u):
        v=View(self);v.setUrl(u);i=self.tabs.addTab(v,"Tab");self.tabs.setCurrentIndex(i)
        xb=QPushButton("✕");xb.setStyleSheet("padding:2px 7px;font-size:13px")
        xb.clicked.connect(lambda _,w=v:self.tabs.removeTab(self.tabs.indexOf(w)) if self.tabs.count()>1 else None)
        self.tabs.tabBar().setTabButton(i,self.tabs.tabBar().ButtonPosition.RightSide,xb)
        v.titleChanged.connect(lambda t,w=v:self.tabs.setTabText(self.tabs.indexOf(w),t[:15] or "Tab"))
        def chk(q,w=v):
            s=q.toString()
            if s.startswith("chrome-error://"):w.setUrl(QUrl(f"http://127.0.0.1:{PORT}/err"));self.bar.setText("");return
            if w==self.cur():self.bar.setText("" if (f"127.0.0.1" in s or s in ("about:blank","")) else s)
        v.urlChanged.connect(chk);v.page().urlChanged.connect(chk);v.loadFinished.connect(lambda ok,w=v:w.page().toHtml(lambda h:w.setUrl(QUrl(f"http://127.0.0.1:{PORT}/err")) if "ERR_" in h else None) if not ok else None)
        return v

